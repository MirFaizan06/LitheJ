<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  LitheJ Checkstyle rules.

  Scope is deliberately narrow: we check things that catch real bugs or
  genuinely harm readability (unused imports, missing braces, unusual
  whitespace, javadoc presence on public API). We do not enforce a full
  Sun/Google style guide, because a wall of stylistic warnings that
  nobody reads defeats the purpose of static analysis.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="TreeWalker">
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport"/>

    <module name="EqualsHashCode"/>
    <module name="EqualsAvoidNull"/>
    <module name="StringLiteralEquality"/>
    <module name="OneStatementPerLine"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <module name="NeedBraces"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>

    <module name="EmptyCatchBlock">
      <property name="commentFormat" value="expected|ignore"/>
    </module>

    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="minLineCount" value="3"/>
      <property name="allowMissingPropertyJavadoc" value="true"/>
      <property name="allowedAnnotations" value="Override, Test"/>
    </module>
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>

    <module name="PackageDeclaration"/>
    <module name="OuterTypeFilename"/>
  </module>
</module>

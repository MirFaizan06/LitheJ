<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for LitheJ.

  Kept intentionally short. Every entry here documents *why* the finding
  is a false positive or an accepted tradeoff for this codebase, rather
  than blanket-suppressing whole categories.
-->
<FindBugsFilter>
  <!-- Generated/test code does not need the same rigor as public API. -->
  <Match>
    <Class name="~.*\.generated\..*"/>
  </Match>

  <!-- JUnit 5 test classes: SpotBugs flags package-private test classes/methods as
       "should be private", which conflicts with JUnit 5's visibility requirements. -->
  <Match>
    <Or>
      <Class name="~.*Test$"/>
      <Class name="~.*Tests$"/>
    </Or>
    <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD,URF_UNREAD_FIELD"/>
  </Match>
</FindBugsFilter>

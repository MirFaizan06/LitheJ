<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="LitheJ"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_2_0_0.xsd">

  <description>
    LitheJ PMD rules: focused on correctness and error-prone patterns
    (best practices, error prone, multithreading) rather than the full
    stylistic rule catalog, to keep signal-to-noise high.
  </description>

  <rule ref="category/java/errorprone.xml">
    <exclude name="BeanMembersShouldSerialize"/>
    <exclude name="AvoidFieldNameMatchingMethodName"/>
    <exclude name="MissingSerialVersionUID"/>
    <!-- UseProperClassLoader assumes a JEE-style container context; a general-purpose
         library legitimately falls back to Class#getClassLoader() when no context
         class loader is set (see lithej.io.Resources). -->
    <exclude name="UseProperClassLoader"/>
  </rule>
  <rule ref="category/java/bestpractices.xml">
    <exclude name="GuardLogStatement"/>
    <exclude name="JUnitAssertionsShouldIncludeMessage"/>
    <exclude name="JUnitTestContainsTooManyAsserts"/>
  </rule>
  <rule ref="category/java/multithreading.xml">
    <exclude name="UseConcurrentHashMap"/>
    <!-- DoNotUseThreads targets managed app-server contexts where raw java.lang.Thread
         bypasses a container-managed executor. LitheJ is not such a container; low-level
         modules (e.g. lithej.process.ProcessX draining a child process's stdout/stderr)
         legitimately manage a small, bounded number of raw threads themselves. -->
    <exclude name="DoNotUseThreads"/>
  </rule>
  <rule ref="category/java/design.xml/AvoidDeeplyNestedIfStmts"/>
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="classReportLevel" value="90"/>
      <property name="methodReportLevel" value="15"/>
    </properties>
  </rule>
</ruleset>
